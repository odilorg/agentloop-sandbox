[Unit]
Description=agentloop: apply ChatGPT Work review requests to agent/* PRs (one cycle)

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 %h/.local/share/agentloop/agentloop.py run
TimeoutStartSec=900
NoNewPrivileges=yes
PrivateTmp=yes
